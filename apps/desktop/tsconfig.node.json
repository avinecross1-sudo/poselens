{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["electron", "src/types/ipc.ts", "src/types/scene.ts", "src/export/naming.ts", "src/export/pngText.ts", "electron.vite.config.ts", "vitest.config.ts", "tailwind.config.ts"]
}
